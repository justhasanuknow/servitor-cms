# Public URL of the application, without a path or trailing slash.
# Also used as the Better Auth base URL.
ORIGIN=https://cms.example.com

# Required. At least 32 random characters, for example the output of: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Retired secrets that may still decrypt stored data after a rotation, separated by commas.
# On start, stored secrets are encrypted again with BETTER_AUTH_SECRET; afterwards this can be emptied.
BETTER_AUTH_PREVIOUS_SECRETS=

# BETTER_AUTH_SECRET, BETTER_AUTH_PREVIOUS_SECRETS, SMTP_PASSWORD and FOUNDER_PASSWORD can also be
# read from a file, for example a Docker secret: set BETTER_AUTH_SECRET_FILE=/run/secrets/auth_secret
# instead of BETTER_AUTH_SECRET. Setting both a variable and its _FILE variant is an error.

# SQLite database file.
DATABASE_PATH=/data/servitor.db

# Directory for uploaded media.
UPLOADS_DIR=/data/uploads

# Largest accepted request body (adapter-node). Uploads can be 10 MB, so keep this at 12M or more.
BODY_SIZE_LIMIT=12M

# Founder account. Used only on the first start while no founder exists, ignored afterwards.
# The password must be 12 to 128 characters long and must not be a common password.
FOUNDER_EMAIL=founder@example.com
FOUNDER_NAME=Founder
FOUNDER_PASSWORD=

# BCP 47 code of the initial default content language. Used only on the first start.
DEFAULT_CONTENT_LANGUAGE=en

# Optional email settings. Set all six to enable email features, or leave all of them empty.
# If only some are set, the app starts with email disabled and logs a warning.
# SMTP_SECURE=true uses TLS from the start (port 465); false requires STARTTLS (port 587).
# A plain connection is only allowed to a relay on the same machine (localhost).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=

# Set to true to allow webhooks to private network targets, including plain http to them.
WEBHOOK_ALLOW_PRIVATE=false

# Client IP detection behind a reverse proxy. Use these only when the app is reachable
# exclusively through the proxy. XFF_DEPTH is the number of trusted proxies in front of the app.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# One of: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
